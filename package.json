{
  "name": "@gutfish/agentready-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Evidence-first repository readiness checks for coding agents.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CYFRON-3/AgentReady.git"
  },
  "homepage": "https://github.com/CYFRON-3/AgentReady#readme",
  "bugs": {
    "url": "https://github.com/CYFRON-3/AgentReady/issues"
  },
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=11 <12"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "action:package": "pnpm --filter @gutfish/agentready-action run package",
    "build": "tsc -b --pretty false",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run action:package",
    "clean": "tsc -b --clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26.4.1",
    "@vitest/coverage-v8": "5.0.0",
    "tsup": "8.5.1",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
